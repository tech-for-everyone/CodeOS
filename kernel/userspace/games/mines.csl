# mines.csl — MINESWEEPER
# csl game: 5x5 board, 5 mines. open r c where r,c are 0-4.
# Board is a 25-char string: '*','digits', and '.' = unexplored.
print "=============================================="
print " MINESWEEPER (5x5, 5 mines)"
print " open r c  -> reveal that cell"
print " flag r c  -> toggle a flag"
print " quit      -> give up"
print " Rows and columns are 0-4."
print "=============================================="

function at_row(row, c) {
    return substr(row, c, 1)
}

function build_board() {
    # start all '.' then drop 5 mines at random unique spots
    let b = "........................."
    let placed = 0
    while placed < 5 {
        let p = rand(25)
        if at_row(b, p) == "." {
            # string rebuild: replace cell p with '*'
            b = substr(b, 0, p) + "*" + substr(b, p + 1, 25 - p - 1)
            placed = placed + 1
        }
    }
    # compute the number hints
    let out = ""
    let i = 0
    while i < 25 {
        if at_row(b, i) == "*" {
            out = out + "*"
        } else {
            let r = mod(i, 5)
            let rr = mod(i, 25)
            # count mines in the 8 neighbours (handle edges by bounds-checking each)
            let cnt = 0
            let dr = -1
            while dr <= 1 {
                let dc = -1
                while dc <= 1 {
                    let nr = (rr / 5) + dr
                    let nc = r + dc
                    if nr >= 0 and nr <= 4 and nc >= 0 and nc <= 4 and (dr != 0 or dc != 0) {
                        let ni = nr * 5 + nc
                        if at_row(b, ni) == "*" {
                            cnt = cnt + 1
                        }
                    }
                    dc = dc + 1
                }
                dr = dr + 1
            }
            out = out + str(cnt)
        }
        i = i + 1
    }
    return out
}

let board = build_board()
let shown = "........................."
let flagged = "........................."
let flags = 5
let game_over = 0
let win = 0

while game_over == 0 {
    print ""
    # render board
    let r = 0
    while r < 5 {
        let line = ""
        let c = 0
        while c < 5 {
            let idx = r * 5 + c
            if at_row(flagged, idx) == "F" {
                line = line + "F "
            } else {
                if at_row(shown, idx) == "s" {
                    line = line + str(at_row(board, idx)) + " "
                } else {
                    line = line + ". "
                }
            }
            c = c + 1
        }
        print line
        r = r + 1
    }
    print "Unflagged mines: " + str(flags)

    print "command:"
    let cmd = lower(trim(readln()))
    if cmd == "quit" {
        game_over = 1
        win = 0
    } else {
        # parse "open 1 2" / "flag 1 2" via split on space
        let parts = split(cmd, " ")
        let op = at(parts, 0)
        let ar = num(at(parts, 1))
        let ac = num(at(parts, 2))
        if ar < 0 or ar > 4 or ac < 0 or ac > 4 {
            print "Coordinates must be 0-4."
        } else {
            let idx = ar * 5 + ac
            if op == "open" {
                # reveal
                shown = substr(shown, 0, idx) + "s" + substr(shown, idx + 1, 25 - idx - 1)
                if at_row(flagged, idx) == "F" {
                    flagged = substr(flagged, 0, idx) + "." + substr(flagged, idx + 1, 25 - idx - 1)
                    flags = flags + 1
                }
                if at_row(board, idx) == "*" {
                    print "KABOOM! You hit a mine."
                    game_over = 1
                    win = 0
                }
            } else {
                if op == "flag" {
                    if at_row(flagged, idx) == "F" {
                        flagged = substr(flagged, 0, idx) + "." + substr(flagged, idx + 1, 25 - idx - 1)
                        flags = flags + 1
                    } else {
                        if flags > 0 {
                            flagged = substr(flagged, 0, idx) + "F" + substr(flagged, idx + 1, 25 - idx - 1)
                            flags = flags - 1
                        } else {
                            print "No flags left."
                        }
                    }
                } else {
                    print "Unknown command."
                }
            }
            # check win: count revealed non-mine cells
            if game_over == 0 {
                let done = 0
                let revealed = 0
                let i = 0
                while i < 25 {
                    if at_row(shown, i) == "s" and at_row(board, i) != "*" {
                        revealed = revealed + 1
                    }
                    i = i + 1
                }
                if revealed == 20 {
                    game_over = 1
                    win = 1
                }
            }
        }
    }
}

print ""
if win == 1 {
    print "You cleared the field — all 5 mines avoided. Nicely done!"
} else {
    print "Game over. The field was:"
    let r = 0
    while r < 5 {
        let line = ""
        let c = 0
        while c < 5 {
            line = line + str(at_row(board, r * 5 + c)) + " "
            c = c + 1
        }
        print line
        r = r + 1
    }
    print "Better luck next time!"
}