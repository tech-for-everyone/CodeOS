# rps.csl — ROCK-PAPER-SCISSORS
# csl game: best of 5 against the machine.
print "=============================================="
print " ROCK / PAPER / SCISSORS"
print " Best of 5 rounds. Type rock, paper, scissors."
print "=============================================="

function winner(p1, p2) {
    # returns 1 if p1 wins vs p2, 0 if draw, 2 if p1 loses
    if p1 == p2 {
        return 0
    }
    if p1 == "rock" and p2 == "scissors" {
        return 1
    }
    if p1 == "scissors" and p2 == "paper" {
        return 1
    }
    if p1 == "paper" and p2 == "rock" {
        return 1
    }
    return 2
}

let picks = "rock paper scissors"
let ws = 0
let ls = 0
let round = 1
while round <= 5 and ws < 3 and ls < 3 {
    print ""
    print "Round " + str(round) + " — rock, paper, or scissors?"
    let player = lower(trim(readln()))
    if player == "rock" or player == "paper" or player == "scissors" {
        let ai = at(split(picks, " "), rand(3))
        print "Machine chose " + str(ai) + "."
        let w = winner(player, ai)
        if w == 1 {
            print "You win this round!"
            ws = ws + 1
        } else {
            if w == 2 {
                print "Machine wins this round."
                ls = ls + 1
            } else {
                print "Draw."
            }
        }
        round = round + 1
    } else {
        print "Type exactly: rock, paper, or scissors."
    }
}

print ""
if ws > ls {
    print "Congrats — you win the match " + str(ws) + "-" + str(ls) + "!"
} else {
    if ls > ws {
        print "Machine wins " + str(ls) + "-" + str(ws) + ". Better luck next time!"
    } else {
        print "It's a tie " + str(ws) + "-" + str(ls) + "."
    }
}