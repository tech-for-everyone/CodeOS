/target/
# Generated build artifacts.  These embed absolute paths from whichever
# machine produced them (clang -MMD writes the compiler invocation's paths
# into .d files, and kernel/scripts/gen_embed.py writes an absolute .incbin),
# so shipping them makes a fresh checkout fail to build with "No rule to make
# target /home/<previous-user>/CodeOS/...".  Both are regenerated by the
# Makefiles; never re-add them to the index.
*.d
__pycache__/
*.pyc
/kernel/kernel/embed_kernel.S

# CMake build trees for the ArkUI/ACE host build.  The generated raw-syscall
# ELF is copied into userspace/ace-layout at build time and embedded in the
# image; neither it nor the CMake cache belongs in git.
/ace-host/build/
/ace-host/build-*/
/userspace/ace-layout

# Cargo lock/timestamp files under tracked target directories.
*.cargo-artifact-lock
*.cargo-build-lock
**/target/**/invoked.timestamp
**/target/**/output-*

# Large files - exclude from git
*.iso
*.img
*.bin
*.a
*.o
*.so
*.dll
qt6/sysroot/usr/lib/*.a
qt6/sysroot/usr/lib/*.o
kernel/codeos-1*.bin
kernel/codeos-1*.iso
kernel/disk.img
codeos-1*.iso
codeos-1*.bin
disk.img

# Pristine upstream GTK4 checkout, used as the source for
# pkgs/core/gtk6/scripts/import-gtk4.sh.  Reference only: the imported (and
# pruned) result is what lives in pkgs/core/gtk6/, and nothing builds from here.
/gtk4/


# bas: the generated C for a .ba program (an intermediate of the cross build)
kernel/userspace/*.ba.c
