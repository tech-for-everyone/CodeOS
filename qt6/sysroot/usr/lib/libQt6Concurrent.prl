QMAKE_PRL_TARGET = libQt6Concurrent.a
QMAKE_PRL_CONFIG = static
QMAKE_PRL_VERSION = 6.11.1
QMAKE_PRL_LIBS = $$[QT_INSTALL_LIBS]/libQt6Core.a $$[QT_INSTALL_LIBS]/libQt6BundledZLIB.a $$[QT_INSTALL_LIBS]/libQt6BundledPcre2.a
QMAKE_PRL_LIBS_FOR_CMAKE = $$[QT_INSTALL_LIBS]/libQt6Core.a;$$[QT_INSTALL_LIBS]/libQt6BundledZLIB.a;$$[QT_INSTALL_LIBS]/libQt6BundledPcre2.a
