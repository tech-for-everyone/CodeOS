# SPDX-License-Identifier: GPL-3.0-or-later
#
# GTK6 — build harness for the Qt6-backed GTK4 platform layer.
#
# The C++ here is compiled the same way as qt6/panels/Makefile: host clang++
# with host libstdc++ headers, but the target's own include path is bought with
# -nostdinc, and the toolchain's startfiles with -nostdlib.  Nothing from the
# host runtime ends up compiled in; the only C++ runtime is Qt6, and the only C
# runtime is CodeOS's libc (linked later, by the kernel Makefile).
#
# Pango/HarfBuzz/Freetype/Fontconfig/Cairo/GdkPixbuf are intentionally absent.
# Text is measured and drawn by Qt (QTextLayout/QFontMetrics/QPainter); see
# qt/qttext.cpp.

HERE := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

# Qt6 sysroot (shared with the top-level qt6/).  This package lives at
# pkgs/core/gtk6, so the repo root is three levels up.  Overridable so the tree
# can be built from a different checkout order.
QTDIR        ?= $(abspath $(HERE)/../../../qt6/sysroot/usr)
GLIB_SYSROOT ?= $(HERE)/sysroot/usr
GLIB_BUILD   ?= $(HERE)/build/glib

CXX ?= clang++
CC  ?= clang
AR  ?= $(shell command -v x86_64-elf-ar >/dev/null 2>&1 && echo x86_64-elf-ar || echo ar)

HOST_GXX         := g++
HOST_GXX_VERSION := $(shell $(HOST_GXX) -dumpversion | cut -d. -f1)
HOST_GXX_TRIPLE  := $(shell $(HOST_GXX) -dumpmachine)

CLANG_RESOURCE_INCLUDE := $(shell $(CXX) -print-file-name=include)

# clang's own builtin headers (stdint.h, stddef.h, immintrin.h, ...) must come
# before the sysroot's copies: passed as -I (never -isystem) because clang
# searches every -I before any -isystem, and the sysroot's immintrin.h uses
# __builtin_ia32_* names clang does not implement.
CLANG_BUILTIN_INCLUDES = -nostdinc -I$(CLANG_RESOURCE_INCLUDE)

HOST_CXX_INCLUDES = \
    -isystem /usr/include/c++/$(HOST_GXX_VERSION) \
    -isystem /usr/include/c++/$(HOST_GXX_VERSION)/$(HOST_GXX_TRIPLE)

QT6_INCLUDES = \
    -I$(QTDIR)/include \
    -I$(QTDIR)/include/QtCore \
    -I$(QTDIR)/include/QtGui \
    -I$(QTDIR)/include/QtWidgets \
    -I$(QTDIR)/include/QtCore/6.11.1 \
    -I$(QTDIR)/include/QtGui/6.11.1 \
    -I$(QTDIR)/include/QtWidgets/6.11.1 \
    -I$(QTDIR)/include/QtGui/6.11.1/QtGui \
    -I$(QTDIR)/include/QtCore/6.11.1/QtCore

# Staged, target-built glib/graphene (scripts/build-glib.sh + stage-glib.sh).
# -I.../include/glib exposes <glib.h>; -I.../include buys <glib/garray.h>.
# glibconfig.h is generated by meson into the build tree and is not a source
# header, so build/glib/glib is on the path too.
GLIB_INCLUDES = \
    -I$(GLIB_SYSROOT)/include \
    -I$(GLIB_SYSROOT)/include/glib \
    -I$(GLIB_SYSROOT)/include/graphene-1.0 \
    -I$(GLIB_BUILD) \
    -I$(GLIB_BUILD)/glib

CXXFLAGS = \
    -std=gnu++17 -O2 -g -Wall -Wextra -Wno-builtin-declaration-mismatch \
    -mcmodel=large -mno-red-zone \
    -fno-exceptions -fno-rtti -fno-threadsafe-statics \
    -fno-stack-protector -fno-PIC \
    -nostdlib -nostartfiles -nodefaultlibs \
    $(CLANG_BUILTIN_INCLUDES) \
    $(HOST_CXX_INCLUDES) \
    $(QT6_INCLUDES) \
    -isystem $(QTDIR)/include/stubs \
    -I$(HERE) \
    $(GLIB_INCLUDES) \
    -DQT_STATICPLUGIN -DQT_NO_OPENGL -DQT_NO_PRINTER -DQT_EXCEPTIONS_OFF \
    -D__codeos__ \
    -include $(abspath $(QTDIR)/include/stubs/cxx_compat.h)

CXX_SRCS := \
    gdk/qt/gdkqt.cpp \
    gdk/qt/gdkqtpaint.cpp \
    gsk/qt/gskqt.cpp \
    qt/qttext.cpp

OBJ := $(patsubst %.cpp,build/obj/%.o,$(CXX_SRCS))
DEP := $(OBJ:.o=.d)

LIB := build/libgtk6qt.a

# ---------------------------------------------------------------------------
# Phase 5 — the imported GTK4 sources (gtk/, gdk/, gsk/)
#
# GTK4's meson generates a dozen headers before a single .c compiles:
# config.h, gdkconfig.h, the enum-type tables, the marshallers and the version
# macros.  scripts/gen-gtk4-headers.py reproduces that with the target-built
# glib tools in build/glib/ and writes them to build/gen/.
#
# The C is built with the x86_64-elf GCC driver (toolchain/cc): the same
# freestanding contract as the C++ modules, but the libc interfaces CodeOS has
# not re-declared come from the host /usr/include — exactly what
# codeos-glib.cross.in does for glib.  (The C++ modules use clang with
# -nostdinc + stubs instead, because Qt brings its own runtime.)
#
# Only the generated .c that have no dropped-library dependency compile yet;
# the rest join the list as the cairo/pango/gdk-pixbuf surgery lands.
# ---------------------------------------------------------------------------

GTK4_GEN   ?= $(HERE)/build/gen
GTK4_STAMP := $(GTK4_GEN)/.stamp
GTK4_CC    ?= $(HERE)/toolchain/cc

GTK4_HEADER_FILES := \
    config.h \
    gdk/gdkconfig.h gtk/gtkconfig.h \
    gdk/version/gdkversionmacros.h gdk/version/gdk-visibility.h \
    gdk/gdkenumtypes.h gdk/gdkenumtypes.c \
    gdk/gdkmarshalers.h gdk/gdkmarshalers.c \
    gsk/gskenumtypes.h gsk/gskenumtypes.c \
    gtk/gtktypebuiltins.h gtk/gtktypebuiltins.c \
    gtk/gtkprivatetypebuiltins.h gtk/gtkprivatetypebuiltins.c \
    gtk/gtkmarshalers.h gtk/gtkmarshalers.c \
    gtk/css/gtkcssenumtypes.h gtk/css/gtkcssenumtypes.c \
    gtk/svg/gtksvgenumtypes.h gtk/svg/gtksvgenumtypes.c \
    gtk/gtktypefuncs.inc

GTK4_CFLAGS = \
    -std=gnu11 -O2 -g -Wall \
    -ffreestanding -mcmodel=large -mno-red-zone -mno-mmx \
    -fno-stack-protector -fno-PIC \
    -D_GNU_SOURCE -D__codeos__ -D__linux__ \
    -DGTK_COMPILATION -DG_LOG_USE_STRUCTURED=1 \
    -isystem /usr/include -isystem /usr/local/include \
    -isystem /usr/lib/gcc/x86_64-pc-linux-gnu/$(HOST_GXX_VERSION)/include \
    -isystem $(QTDIR)/include \
    -I$(GLIB_SYSROOT)/include \
    -I$(GLIB_SYSROOT)/include/glib \
    -I$(GLIB_SYSROOT)/include/gmodule \
    -I$(GLIB_SYSROOT)/include/graphene-1.0 \
    -I$(GLIB_SYSROOT)/lib/graphene-1.0/include \
    -I$(GLIB_BUILD) -I$(GLIB_BUILD)/glib \
    -I$(GTK4_GEN) -I$(GTK4_GEN)/gdk -I$(GTK4_GEN)/gtk -I$(GTK4_GEN)/gsk \
    -I$(HERE) \
    -I$(HERE)/gdk -I$(HERE)/gsk -I$(HERE)/gtk \
    -I$(HERE)/gtk/css -I$(HERE)/gtk/svg \
    -I$(HERE)/gdk/text

GTK4_GEN_SRCS := \
    gdk/gdkmarshalers.c \
    gtk/gtkmarshalers.c \
    gtk/css/gtkcssenumtypes.c

GTK4_GEN_OBJ := $(patsubst %.c,build/obj/gtk4/%.o,$(GTK4_GEN_SRCS))

# GTK6's own C sources that belong to the GTK4 layer (as opposed to the C++
# engine in CXX_SRCS).  They are compiled with the same freestanding contract
# as the imported sources, from $(HERE) rather than build/gen/.
GTK4_OWN_SRCS := \
    gdk/gdkpaintenumtypes.c

GTK4_OWN_OBJ := $(patsubst %.c,build/obj/gtk4/src/%.o,$(GTK4_OWN_SRCS))

# Compile-only probes for the surgery: each adds a public header that upstream
# dragged cairo/pango in through.  They are never linked or run.
GTK4_PROBES := tests/gdktypes.c tests/gdkregion.c tests/gdkpaint.c tests/gdktext.c


.PHONY: all clean check gtk4-headers gtk4-generated gtk4-check gtk4-ledger gtk4-clean

all: $(LIB)

$(LIB): $(OBJ)
	@mkdir -p $(dir $@)
	$(AR) rcs $@ $^

build/obj/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Compile-only validation that the public headers are self-consistent for a
# freestanding C++ consumer (Phase 0's "hello widget" placeholder).
check: $(LIB) tests/linkcheck.o
	@echo "gtk6: $(LIB) and linkcheck.o built"

tests/linkcheck.o: tests/linkcheck.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Regenerate the GTK4 config/enum/marshaler headers.  The target-built glib
# tools are the only prerequisite, so glib is rebuilt only when build/glib is
# absent (scripts/build-glib.sh is not itself incremental).
gtk4-headers: $(GTK4_STAMP)

$(GLIB_BUILD)/gobject/glib-mkenums:
	$(HERE)/scripts/build-glib.sh

$(GTK4_STAMP): $(HERE)/scripts/gen-gtk4-headers.py | $(GLIB_BUILD)/gobject/glib-mkenums
	@mkdir -p $(GTK4_GEN)
	python3 $(HERE)/scripts/gen-gtk4-headers.py \
	    --out $(GTK4_GEN) --glib-build $(GLIB_BUILD)
	@touch $@

gtk4-generated: $(GTK4_GEN_OBJ)

build/obj/gtk4/%.o: $(GTK4_STAMP)
	@mkdir -p $(dir $@)
	$(GTK4_CC) $(GTK4_CFLAGS) -c $(GTK4_GEN)/$*.c -o $@

build/obj/gtk4/src/%.o: %.c
	@mkdir -p $(dir $@)
	$(GTK4_CC) $(GTK4_CFLAGS) -c $< -o $@

gtk4-check: gtk4-headers gtk4-generated $(GTK4_OWN_OBJ) $(GTK4_PROBES:%.c=build/obj/gtk4/%.o)
	@for f in $(GTK4_HEADER_FILES); do \
	    test -s "$(GTK4_GEN)/$$f" || \
	        { echo "gtk4-check: missing or empty $(GTK4_GEN)/$$f" >&2; exit 1; }; \
	done
	@echo "gtk4-check: $(words $(GTK4_HEADER_FILES)) generated files, $(words $(GTK4_GEN_SRCS)) generated C files, $(words $(GTK4_OWN_SRCS)) own C files and $(words $(GTK4_PROBES)) probes compiled on the target"

build/obj/gtk4/tests/%.o: tests/%.c
	@mkdir -p $(dir $@)
	$(GTK4_CC) $(GTK4_CFLAGS) -c $< -o $@

gtk4-ledger: gtk4-headers
	GTK4_CC='$(GTK4_CC)' GTK4_CFLAGS='$(GTK4_CFLAGS)' \
	    $(HERE)/scripts/gtk4-ledger.sh

gtk4-clean:
	rm -rf $(GTK4_GEN) build/obj/gtk4

clean:
	rm -rf build/obj tests/linkcheck.o tests/linkcheck.d $(LIB)

-include $(DEP)
