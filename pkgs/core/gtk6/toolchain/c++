#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# C++ counterpart of toolchain/cc: drops the unsupported -pthread driver flag
# that glib's `dependency('threads')` injects, then calls the CodeOS
# freestanding C++ cross compiler.  See cc for the rationale.
args=()
for a in "$@"; do
    [[ "$a" == "-pthread" ]] && continue
    args+=("$a")
done
exec x86_64-elf-g++ "${args[@]}"
