# CodeOS glib cross-file — mirrors qt6/cmake/codeos-toolchain.cmake:
# x86_64-elf toolchain, freestanding, host libc headers, minimal CodeOS libc.
[binaries]
c = '/home/codeosuser/CodeOS/gtk6/deps/bin/cc'
cpp = '/home/codeosuser/CodeOS/gtk6/deps/bin/c++'
ar = 'x86_64-elf-ar'
ranlib = 'x86_64-elf-ranlib'
strip = 'x86_64-elf-strip'
pkgconfig = 'pkg-config'

[host_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['-ffreestanding', '-mcmodel=large', '-mno-red-zone', '-mno-mmx', '-fno-stack-protector', '-fno-PIC', '-D_GNU_SOURCE', '-D__codeos__', '-D__linux__', '-isystem/usr/include', '-isystem/usr/local/include', '-isystem/usr/lib/gcc/x86_64-pc-linux-gnu/16/include', '-isystem/home/codeosuser/CodeOS/qt6/sysroot/usr/include']
cpp_args = ['-ffreestanding', '-mcmodel=large', '-mno-red-zone', '-mno-mmx', '-fno-stack-protector', '-fno-PIC', '-D_GNU_SOURCE', '-D__codeos__', '-D__linux__', '-isystem/usr/include', '-isystem/usr/local/include', '-isystem/usr/lib/gcc/x86_64-pc-linux-gnu/16/include', '-isystem/home/codeosuser/CodeOS/qt6/sysroot/usr/include']
c_link_args = ['-nostdlib', '-mcmodel=large', '-no-pie', '-Wl,--allow-multiple-definition', '-L/home/codeosuser/CodeOS/qt6/sysroot/usr/lib', '-L/home/codeosuser/CodeOS/gtk6/deps/lib', '-Wl,--start-group', '-lminc', '-lcodeos_posixstubs', '-liconv', '-lmathshim', '-Wl,--end-group']
cpp_link_args = ['-nostdlib', '-mcmodel=large', '-no-pie', '-Wl,--allow-multiple-definition', '-L/home/codeosuser/CodeOS/qt6/sysroot/usr/lib', '-L/home/codeosuser/CodeOS/gtk6/deps/lib', '-Wl,--start-group', '-lminc', '-lcodeos_posixstubs', '-liconv', '-lmathshim', '-Wl,--end-group']
